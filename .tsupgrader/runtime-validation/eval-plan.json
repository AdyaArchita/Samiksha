{
  "projectType": "webapp",
  "setup": [
    {
      "command": "npm",
      "args": ["ci", "--legacy-peer-deps"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
